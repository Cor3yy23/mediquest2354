using MediQuest.Api.Data;
using MediQuest.Api.Models;
using Microsoft.EntityFrameworkCore;

namespace MediQuest.Api.Services;

public class DoseService
{
    private readonly AppDbContext _dbContext;
    private readonly QuestService _questService;

    public DoseService(AppDbContext dbContext, QuestService questService)
    {
        _dbContext = dbContext;
        _questService = questService;
    }

    public async Task<DoseCompleteResponse> CompleteDoseAsync(DoseCompleteRequest request)
    {
        var medication = await _dbContext.Medications
            .FirstOrDefaultAsync(m => m.Id == request.MedicationId);

        if (medication is null)
        {
            throw new InvalidOperationException("Medication not found.");
        }

        var xpEarned = request.Status switch
        {
            DoseStatus.OnTime => 10,
            DoseStatus.Late => 5,
            DoseStatus.Prn => 2,
            _ => 0
        };

        var doseLog = new DoseLog
        {
            MedicationId = medication.Id,
            TakenAt = DateTime.UtcNow,
            Status = request.Status,
            XpEarned = xpEarned
        };

        _dbContext.DoseLogs.Add(doseLog);

        var user = await _dbContext.Users.FirstAsync(u => u.Id == DemoConstants.DemoUserId);
        var party = await _dbContext.Parties.FirstAsync(p => p.Id == DemoConstants.DemoPartyId);

        user.TotalXp += xpEarned;
        party.TotalXp += xpEarned;

        await _questService.ApplyDoseAsync(doseLog.TakenAt);

        await _dbContext.SaveChangesAsync();

        var level = StatsService.CalculateLevel(user.TotalXp);
        return new DoseCompleteResponse(doseLog.Id, xpEarned, user.TotalXp, level);
    }
}
