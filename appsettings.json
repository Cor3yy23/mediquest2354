using System.Security.Cryptography;
using System.Text;
using System.Text.Json;
using MediQuest.Api.Data;
using MediQuest.Api.Models;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Caching.Memory;

namespace MediQuest.Api.Services;

public record PkceState(string UserId, string Verifier);
public record EpicCallbackResult(bool Success, string Message, int? TokenStatusCode = null, Dictionary<string, object?>? Diagnostics = null);

public class EpicSmartService
{
    private readonly HttpClient _httpClient;
    private readonly IConfiguration _configuration;
    private readonly IMemoryCache _cache;
    private readonly AppDbContext _dbContext;
    private readonly ILogger<EpicSmartService> _logger;

    public EpicSmartService(HttpClient httpClient, IConfiguration configuration, IMemoryCache cache, AppDbContext dbContext, ILogger<EpicSmartService> logger)
    {
        _httpClient = httpClient;
        _configuration = configuration;
        _cache = cache;
        _dbContext = dbContext;
        _logger = logger;
    }

    public async Task<(string AuthorizationEndpoint, string TokenEndpoint)> DiscoverAsync()
    {
        var fhirBaseUrl = _configuration["Epic:FhirBaseUrl"]!;
        var response = await _httpClient.GetStringAsync($"{fhirBaseUrl}/.well-known/smart-configuration");
        using var doc = JsonDocument.Parse(response);
        return (
            doc.RootElement.GetProperty("authorization_endpoint").GetString()!,
            doc.RootElement.GetProperty("token_endpoint").GetString()!);
    }

    public (string Verifier, string Challenge) GeneratePkce()
    {
        var bytes = RandomNumberGenerator.GetBytes(64);
        var verifier = Base64UrlEncode(bytes);
        using var sha = SHA256.Create();
        var challenge = Base64UrlEncode(sha.ComputeHash(Encoding.ASCII.GetBytes(verifier)));
        return (verifier, challenge);
    }

    public string BuildAuthorizeUrl(string userId, string state, string verifier, string challenge, string authorizationEndpoint)
    {
        _cache.Set($"epic:{state}", new PkceState(userId, verifier), TimeSpan.FromMinutes(10));
        var fhirBaseUrl = _configuration["Epic:FhirBaseUrl"]!;
        var clientId = _configuration["Epic:ClientId"]!;
        var redirectUri = _configuration["Epic:RedirectUri"]!;
        var scopes = _configuration["Epic:Scopes"]!;
        var query = new Dictionary<string, string>
        {
            ["response_type"] = "code",
            ["client_id"] = clientId,
            ["redirect_uri"] = redirectUri,
            ["scope"] = scopes,
            ["state"] = state,
            ["code_challenge"] = challenge,
            ["code_challenge_method"] = "S256",
            ["aud"] = fhirBaseUrl
        };
        var queryString = string.Join("&", query.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"));
        return $"{authorizationEndpoint}?{queryString}";
    }

    public async Task<EpicCallbackResult> HandleCallbackAsync(string code, string state, string? expectedUserId = null)
    {
        var hasCode = !string.IsNullOrWhiteSpace(code);
        var hasState = !string.IsNullOrWhiteSpace(state);
        var hasStateInCache = _cache.TryGetValue<PkceState>($"epic:{state}", out var pkce);
        var userId = pkce?.UserId;
        var expectedUserMatches = string.IsNullOrWhiteSpace(expectedUserId) || string.Equals(userId, expectedUserId, StringComparison.Ordinal);
        var hasPkceVerifier = !string.IsNullOrWhiteSpace(pkce?.Verifier);

        if (!hasStateInCache || !expectedUserMatches || !hasPkceVerifier)
        {
            return new EpicCallbackResult(false, "Invalid or expired state.");
        }
        var verifier = pkce!.Verifier;

        var (_, tokenEndpoint) = await DiscoverAsync();
        var content = new FormUrlEncodedContent(new Dictionary<string, string>
        {
            ["grant_type"] = "authorization_code",
            ["code"] = code,
            ["redirect_uri"] = _configuration["Epic:RedirectUri"]!,
            ["client_id"] = _configuration["Epic:ClientId"]!,
            ["code_verifier"] = verifier!
        });

        var redirectUri = _configuration["Epic:RedirectUri"]!;
        var clientId = _configuration["Epic:ClientId"]!;
        var response = await _httpClient.PostAsync(tokenEndpoint, content);
        var responseBody = await response.Content.ReadAsStringAsync();
        if (!response.IsSuccessStatusCode)
        {
            var diagnostics = new Dictionary<string, object?>
            {
                ["tokenEndpointUrl"] = tokenEndpoint,
                ["tokenStatusCode"] = (int)response.StatusCode,
                ["epicResponseBody"] = responseBody,
                ["configuredRedirectUri"] = redirectUri,
                ["tokenRequestRedirectUri"] = redirectUri,
                ["clientId"] = clientId,
                ["stateFound"] = hasStateInCache,
                ["pkceVerifierExists"] = hasPkceVerifier,
                ["expectedUserIdMatchedStateOwner"] = expectedUserMatches,
                ["codePresent"] = hasCode,
                ["statePresent"] = hasState,
            };
            return new EpicCallbackResult(
                false,
                "Epic connection failed during token exchange. Start Connect Epic again.",
                (int)response.StatusCode,
                diagnostics);
        }

        using var doc = JsonDocument.Parse(responseBody);
        var expiresIn = doc.RootElement.TryGetProperty("expires_in", out var expiresProp) ? expiresProp.GetInt32() : 3600;

        var connection = await _dbContext.EpicConnections.FirstOrDefaultAsync(x => x.UserId == userId) ?? new EpicConnection { UserId = userId };
        connection.FhirBaseUrl = _configuration["Epic:FhirBaseUrl"]!;
        connection.AccessToken = doc.RootElement.GetProperty("access_token").GetString()!;
        connection.RefreshToken = doc.RootElement.TryGetProperty("refresh_token", out var refresh) ? refresh.GetString() : null;
        connection.PatientId = doc.RootElement.TryGetProperty("patient", out var patient) ? patient.GetString() : null;
        connection.IdToken = doc.RootElement.TryGetProperty("id_token", out var idToken) ? idToken.GetString() : null;
        connection.Scopes = doc.RootElement.TryGetProperty("scope", out var scope) ? scope.GetString() ?? string.Empty : string.Empty;
        connection.ExpiresAt = DateTime.UtcNow.AddSeconds(expiresIn);
        connection.UpdatedAt = DateTime.UtcNow;
        connection.User = await _dbContext.Users.FirstAsync(x => x.Id == userId);

        if (_dbContext.Entry(connection).State == EntityState.Detached)
        {
            _dbContext.EpicConnections.Add(connection);
        }

        _logger.LogInformation("Epic callback persisting EpicConnection for user {UserId}.", userId);
        try
        {
            await _dbContext.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Epic callback failed while saving EpicConnection for user {UserId}.", userId);
            return new EpicCallbackResult(
                false,
                "Epic connection failed while saving connection data. Please try Connect Epic again.",
                null,
                new Dictionary<string, object?>
                {
                    ["saveStage"] = "SaveChangesAsync",
                    ["stateFound"] = hasStateInCache,
                    ["expectedUserIdMatchedStateOwner"] = expectedUserMatches
                });
        }
        _logger.LogInformation("Epic callback saved EpicConnection for user {UserId}.", userId);
        _cache.Remove($"epic:{state}");
        return new EpicCallbackResult(true, "Epic connected.");
    }

    private static string Base64UrlEncode(byte[] data) => Convert.ToBase64String(data).TrimEnd('=').Replace('+', '-').Replace('/', '_');
}
